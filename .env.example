# Copy to .env for local development. On Railway set these in the Variables
# tab (Phase 4, Step 2) instead - never commit a real .env.

# ---- Phase 3: Supabase ----------------------------------------------------
# Project Settings -> Database -> Connection string -> URI
# Replace [YOUR-PASSWORD]. The app rewrites postgresql:// to
# postgresql+asyncpg:// automatically if you forget.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR-PASSWORD@db.xxxxx.supabase.co:5432/postgres

# ---- Phase 3b: Upstash ----------------------------------------------------
REDIS_URL=rediss://default:YOUR-PASSWORD@xxxxx.upstash.io:6379

# ---- Phase 4: Railway -----------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=production
PORT=8000

# ---- Phase 6 addendum: RapidAPI -------------------------------------------
# From your API's Configuration tab on RapidAPI. NOT in the original
# deployment guide, and the single most important variable you will set:
# without it, anyone who finds your Railway URL uses the API for free,
# because RapidAPI meters on their side, not yours.
RAPIDAPI_PROXY_SECRET=

# ---- Phase 9: GitHub Pages docs -------------------------------------------
# Where your docs live. Emitted in the OpenAPI spec, the Link header and
# llms.txt so AI crawlers can find the guides from the API host.
DOCS_BASE_URL=https://YOUR-GITHUB-USERNAME.github.io/agent-memory-api

# ---- Embeddings -----------------------------------------------------------
# hashing = works immediately, no key, matches vocabulary not meaning
# openai  = real semantic matching, needs a key, ~$0.00002 per store
EMBEDDING_PROVIDER=hashing
OPENAI_API_KEY=

# ---- Optional tuning ------------------------------------------------------
LOG_LEVEL=INFO
CACHE_ENABLED=true
WEIGHT_SEMANTIC=0.55
WEIGHT_LEXICAL=0.25
WEIGHT_SALIENCE=0.20
DECAY_RATE_PER_DAY=0.015

# Local dev only. Lets you call the API with no auth header at all.
# NEVER set this true in production.
ALLOW_ANONYMOUS_DEV_TENANT=false
